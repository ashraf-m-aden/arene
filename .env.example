# ─── API ────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/arene
REDIS_URL=
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ─── Stockage des fichiers (local | s3) ─────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_REGION=eu-west-3
S3_BUCKET_PUBLIC=arene-media-public
S3_BUCKET_PRIVATE=arene-dossiers-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_PUBLIC_URL=

# ─── Notifications ──────────────────────────────────────────────────────────
SES_REGION=eu-west-3
SES_FROM="L'Arène <no-reply@dj-arene.com>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ─── Public ─────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:3000
DEFAULT_LOCALE=fr

# ─── Front Nuxt ─────────────────────────────────────────────────────────────
NUXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000
