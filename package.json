{
  "name": "generationmerite",
  "version": "1.0.0",
  "private": true,
  "description": "Génération Mérite — plateforme du tournoi de duels de football 1v1 (Djibouti)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @gm/api",
    "dev:web": "npm run dev --workspace @gm/web",
    "dev:worker": "npm run worker --workspace @gm/api",
    "build": "npm run build --workspace @gm/web",
    "seed": "npm run seed --workspace @gm/api",
    "test": "npm run test --workspace @gm/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"apps/web/**/*.scss\"",
    "docker:up": "docker compose -f docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.yml down"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "npm-run-all2": "^7.0.1",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0"
  }
}
