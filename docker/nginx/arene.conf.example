# ── ARÈNE ────────────────────────────────────────────────────
# PHASE 2 : remplace arene.phase1-http.conf une fois que
# /etc/letsencrypt/live/dj-arene.com/{fullchain,privkey}.pem existent.
#
# Ports amont (config.js : API_PORT=4000 ; web.Dockerfile : NITRO_PORT=3000) :
#   arene-api → 4000 ; arene-web → 3000

# HTTP : défi ACME (renouvellements) + redirection vers HTTPS
server {
    listen 80;
    server_name dj-arene.com www.dj-arene.com;

    location ^~ /.well-known/acme-challenge/ {
        root /etc/letsencrypt/webroot-arene;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://dj-arene.com$request_uri;
    }
}

# HTTPS www → apex
server {
    listen 443 ssl;
    ssl_certificate     /etc/letsencrypt/live/dj-arene.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dj-arene.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    server_name www.dj-arene.com;

    return 301 https://dj-arene.com$request_uri;
}

# HTTPS principal
server {
    listen 443 ssl;
    ssl_certificate     /etc/letsencrypt/live/dj-arene.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dj-arene.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    server_name dj-arene.com;

    # Bulletins et photos d'identité transitent par l'API (défaut nginx : 1 Mo)
    client_max_body_size 20m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;

    # Résolution au moment de la requête : nginx démarre/recharge même si
    # les conteneurs Arène sont arrêtés (même schéma que les tenants Totalis).
    resolver 127.0.0.11 valid=30s;
    set $backend  arene-api;
    set $frontend arene-web;

    location /api/ {
        proxy_pass         http://$backend:4000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host $host;
        proxy_buffering    off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
    }

    location / {
        proxy_pass         http://$frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_buffering    off;
    }
}
