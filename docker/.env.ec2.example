# Copier en .env.ec2 sur l'EC2 (jamais commité) puis :
#   docker compose -f docker/docker-compose.ec2.yml --env-file .env.ec2 up -d

IMAGE_TAG=latest

# ── Domaine ──
NUXT_PUBLIC_SITE_URL=https://VOTRE-DOMAINE.tld
NUXT_PUBLIC_API_BASE=https://VOTRE-DOMAINE.tld/api/v1

# ── MongoDB déjà présent sur l'EC2 ──
# Remplacez <conteneur-mongo> par le nom réel du conteneur (docker ps | grep mongo),
# et <user>/<pass> si l'instance demande une authentification.
MONGO_URI=mongodb://<conteneur-mongo>:27017/arene

# ── Redis dédié (conteneur généré par ce compose) ──
REDIS_PASSWORD=changez-cette-valeur-obligatoirement

# ── Secrets JWT — générez avec `openssl rand -hex 32` ──
JWT_SECRET=changez-cette-valeur-obligatoirement
JWT_REFRESH_SECRET=changez-cette-autre-valeur-obligatoirement

# ── S3 (photos et bulletins) ──
# Pas de clés AWS ici si l'instance EC2 a un rôle IAM avec accès à ces buckets
# (recommandé) ; sinon, décommentez et renseignez AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_BUCKET_PUBLIC=arene-public
S3_BUCKET_PRIVATE=arene-private
S3_REGION=eu-west-3
# CDN_PUBLIC_URL=https://cdn.votre-domaine.tld

# ── Email (AWS SES) ──
SES_REGION=eu-west-3
SES_FROM=L'Arène <no-reply@VOTRE-DOMAINE.tld>

# ── WhatsApp (optionnel) ──
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
