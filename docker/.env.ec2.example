# Copier en .env.ec2 sur l'EC2 (jamais commité) puis :
#   docker compose -f docker/docker-compose.ec2.yml --env-file .env.ec2 up -d

IMAGE_TAG=latest

# ── Domaine ──
NUXT_PUBLIC_SITE_URL=https://dj-arene.com
NUXT_PUBLIC_API_BASE=https://dj-arene.com/api/v1

# ── Données (bind mounts mongo/ et redis/) ──
ARENE_DATA_DIR=/home/ubuntu/arene/data

# ── MongoDB dédié (conteneur arene-mongodb généré par ce compose) ──
# Root créé au premier démarrage ; l'API utilise arene_app (readWrite sur arene).
MONGO_ROOT_PASSWORD=changez-cette-valeur-obligatoirement
MONGO_URI=mongodb://arene_app:<mot-de-passe>@arene-mongodb:27017/arene?authSource=arene

# ── Redis dédié (conteneur généré par ce compose) ──
REDIS_PASSWORD=changez-cette-valeur-obligatoirement

# ── Secrets JWT — générez avec `openssl rand -hex 32` ──
JWT_SECRET=changez-cette-valeur-obligatoirement
JWT_REFRESH_SECRET=changez-cette-autre-valeur-obligatoirement

# ── S3 (photos et bulletins) ──
# Utilisateur IAM dédié arene-s3 (pas le rôle d'instance, partagé avec Totalis) :
# Put/Get/DeleteObject sur les deux buckets ci-dessous uniquement.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=arene-public
S3_BUCKET_PRIVATE=arene-private
S3_REGION=eu-west-3
# CDN_PUBLIC_URL=https://cdn.dj-arene.com

# ── Email (AWS SES) ──
# L'identité dj-arene.com est vérifiée dans us-east-1 (pas dans la région S3).
SES_REGION=us-east-1
SES_FROM=L'Arène <no-reply@dj-arene.com>
# Boite de l'organisation, prevenue a chaque dossier depose. La vider coupe ces
# alertes. Elle doit pouvoir recevoir du courrier (MX du domaine) : un rebond
# definitif la ferait entrer dans la liste de suppression, et les alertes
# s'arreteraient sans bruit.
ORG_EMAIL=contact@dj-arene.com
# Topic SNS qui relaie rebonds et plaintes vers /api/v1/notifications/webhooks/ses.
# Sans lui, un topic SNS tiers pourrait faire supprimer des adresses.
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<compte>:arene-ses-events

# ── WhatsApp (optionnel) ──
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
